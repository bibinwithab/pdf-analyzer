# backend/Dockerfile
FROM python:3.10-slim

# Set working directory
WORKDIR /app

# Copy backend files
COPY backend/ /app

# Install dependencies
RUN pip install --upgrade pip \
    && pip install -r requirements.txt

# Expose FastAPI port
EXPOSE 8000

# Run the FastAPI app
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
